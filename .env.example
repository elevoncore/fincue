# ============================================================================
# ENVIRONMENT VARIABLE TEMPLATE
# Copy this file:
#   - to `apps/web/.env.local`      for the Next.js web app
#   - to `services/ai-engine/.env`  for the Python ai-engine
# Fill in real values from your own Supabase / Groq / Gemini accounts.
# NEVER commit a file containing real secrets. See docs/security.md.
# ============================================================================

# --- App metadata -----------------------------------------------------------
NODE_ENV=development
APP_ENV=local                      # local | staging | production

# --- Supabase (Database + Auth + Storage + Realtime) ------------------------
# From: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side ONLY, never expose to the client bundle
SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Decoupled AI engine (services/ai-engine) --------------------------------
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_INTERNAL_API_KEY=generate-a-long-random-string   # shared secret: web/mobile -> ai-engine

# --- LLM providers for the NLP assistant (see docs/ml-strategy.md) ----------
# Primary: Google AI Studio free tier (generous daily quota, no card required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Fallback: Groq free tier (very low latency, tighter rate limits)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Currency exchange (see docs/ml-strategy.md) ----------------------------
EXCHANGE_RATE_PRIMARY_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1
EXCHANGE_RATE_FALLBACK_BASE_URL=https://open.er-api.com/v6

# --- Investment account aggregation (Phase 2 / stretch — see docs/PRD.md) --
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                  # sandbox | trial | production

# --- Push notifications ------------------------------------------------------
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# --- Error monitoring ---------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Object storage for receipt images (optional scale-up; see docs/deployment.md) --
# Leave blank to use Supabase Storage (default, simplest for MVP).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
